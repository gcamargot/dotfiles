# Sensitive keys and credentials (NEVER commit)
id_*
*.pem
*.key
*.pub
credentials
*.secret
*.token
.env
.env.*
!.env.example

# Shell history
.*_history*
.bash_history
.zsh_history

# Local overrides (untracked machine-specific customizations)
*.local
.bashrc.local
.zshrc.local
.aliases.local
.gitconfig.local

# Editor / OS temporary files
.DS_Store
*.swp
*.swo
*~
.netrwhist
undo/
.idea/
.vscode/

# Package manager / tool caches
node_modules/
.cache/
